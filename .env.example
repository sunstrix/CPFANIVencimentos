# ============================================================
# Controle de Vencimentos CP FANI — MOLDE de configuração
# ------------------------------------------------------------
# 1) Copie para .env:  Copy-Item .env.example .env
# 2) Preencha os valores reais SOMENTE no .env.
# 3) O .env já está bloqueado pelo .gitignore — nunca o commite.
# Este molde não contém (e nunca deve conter) segredos reais.
# ============================================================

# --- Aplicação ---
# development | production (production ativa cookies Secure e valida a config)
APP_ENV=development
# Fuso oficial do negócio: define o "mês atual" dos alertas e o bloqueio de vencidos
APP_TIMEZONE=America/Sao_Paulo
LOG_LEVEL=INFO
# Porta do servidor local (waitress). Em produção o host injeta PORT.
PORT=5000

# --- Segurança / sessão ---
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
# Em production, config.py REJEITA este placeholder.
SECRET_KEY=troque-por-64-hex-gerado-com-secrets-token_hex
# JSON usuário -> hash de senha (werkzeug). Gere com scripts/gerar_hashes.py.
# Formato: {"escritorio":"scrypt:32768:8:1$...","<login_loja>":"scrypt:32768:8:1$..."}
# {} = nenhum usuário cadastrado (o app recusa subir em production).
AUTH_USERS_JSON={}
# Duração da sessão logada, em minutos. 480 = turno de 8h.
SESSION_LIFETIME_MINUTES=480
# Anti força bruta no login, por IP (sintaxe do Flask-Limiter).
LOGIN_RATE_LIMIT="5 per minute"

# --- Google Sheets: credenciais da service account ---
# Opção A (dev local): caminho do JSON baixado do Google Cloud.
# A pasta secrets/ e o padrão service_account*.json já estão no .gitignore.
GOOGLE_CREDENTIALS_FILE=secrets/service_account.json
# Opção B (produção: Koyeb/HF Spaces): JSON INTEIRO em uma única linha.
# Se preenchida, tem prioridade sobre a Opção A. Nunca commite a chave real.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Google Sheets: planilhas ---
# Lançamentos (escrita): planilha PRÓPRIA, separada da base de preços.
# Crie com scripts/setup_planilha.py, compartilhe com a service account
# (permissão de editor) e cole o ID (trecho entre /d/ e /edit da URL).
LANCAMENTOS_SHEET_ID=
LANCAMENTOS_TAB=Lancamentos
# Produtos/preços (SOMENTE leitura para a service account).
# ID é identificador, não segredo. Colunas: SKU | Descrição | Preço.
PRODUTOS_SHEET_ID=1oVhF029CHvgZi8rFaagqtHb3_CnYmPFvjhDZzBIa1wY
# Vazio = usa a 1ª aba da planilha de preços. Preencha só se quiser outra aba.
PRODUTOS_TAB=

# --- Cache em memória (protege a quota: 60 req/min/usuário da API) ---
# Base de preços, em segundos (muda pouco; expira também no restart).
PRODUTOS_CACHE_TTL=600
# Lançamentos, em segundos (invalidado imediatamente após cada escrita).
LANCAMENTOS_CACHE_TTL=60